{
  // extends를 쓰는 이유: Vue DOM 환경용 기본 TS 설정을 상속받아서 중복을 줄이기 위함
  "extends": "@vue/tsconfig/tsconfig.dom.json",

  "compilerOptions": {
    // baseUrl을 쓰는 이유: paths 별칭 해석 기준을 프로젝트 루트로 잡기 위해
    "baseUrl": ".",

    // paths를 쓰는 이유: '@/*'를 'src/*'로 매핑해서 TS가 절대경로를 이해하게 하기 위해
    "paths": {
      "@/*": ["src/*"]
    },

    // types를 쓰는 이유: Vite 환경 타입(import.meta 등)을 TS가 알게 하기 위함
    "types": ["vite/client"]
  },

  // include를 쓰는 이유: 앱 소스(.ts/.vue)를 TS 검사 대상으로 포함하기 위함
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
